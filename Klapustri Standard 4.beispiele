<!doctype html><html lang="de"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>KaPuStri – Standard – neue Zahlen</title><style>*{box-sizing:border-box}body{margin:0;background:#edf3fa;color:#19324e;font:18px system-ui}main{max-width:1100px;margin:auto;padding:22px}section{background:white;padding:22px;margin:18px 0;border-radius:16px}button,input{font:inherit;color:inherit;background:white;padding:11px;border:1px solid #a9bad0;border-radius:8px}button{cursor:pointer}button:hover{background:#e5efff}.primary,.active{background:#285aab;color:white}nav,.tools{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0}.eq{font:clamp(18px,3vw,27px) ui-monospace,monospace;line-height:2.5;overflow-wrap:anywhere}.part{font:inherit;border:0;background:transparent;padding:4px 0;white-space:pre-wrap}.selected,u{text-decoration:underline;text-decoration-color:#17834c;text-decoration-thickness:3px;text-underline-offset:7px}.selected{background:#e7f6e9}.past{color:#5d7089;border-bottom:1px solid #dee7f1}.stage{background:#f1f5fc;padding:16px;border-radius:12px}.wide{width:100%;font-family:monospace;margin:10px 0}label{display:block;margin-top:10px}p{line-height:1.6}.small{font-size:15px;color:#536981;line-height:1.6}.good{color:#14713f}.bad{color:#a52c30}#msg{min-height:32px;margin:16px 0}table{width:100%;border-collapse:collapse;font-size:15px}th,td{border:1px solid #c6d4e6;padding:8px;text-align:left}.tablewrap{overflow:auto}[hidden]{display:none!important}@media(max-width:500px){main{padding:12px}section{padding:15px}}@media print{#learning,.noprint{display:none!important}#report{display:block!important}body{background:white}main,section{padding:0}button{display:none}table{font-size:11px}}</style></head><body><main><div id="learning"><h1>KaPuStri – Standard-Gruppe</h1><label for="name">Name:</label><input id="name" autocomplete="name" placeholder="Vor- und Nachname"><p>Rechenteile anklicken → „Auswahl fertig“ → Vorzeichen auflösen → Ergebnis berechnen → nächste Zeile übertragen → weiter bis zum Endergebnis.</p><p class="small">Unabhängige gleichrangige Teile dürfen gemeinsam grün unterstrichen werden. Teile mit einer gemeinsamen Zahl werden von links nach rechts berechnet. Bei nur einer verbleibenden Operation entfällt das Unterstreichen. Klammern vor Punkt vor Strich.</p><p id="overall" class="small"></p><nav id="nav" aria-label="Aufgabenauswahl"></nav><section><h2 id="title"></h2><p id="instruction"></p><div id="history"></div><div id="equation" class="eq"></div><button id="choose" class="primary" hidden>Auswahl fertig</button><form id="signform" class="stage" hidden><label for="sign">Vorzeichen des aktuellen Rechenteils auflösen – noch nicht ausrechnen:</label><input id="sign" class="wide" autocomplete="off" spellcheck="false" placeholder="z. B. −5 + 2"><button class="primary">Vorzeichen prüfen</button></form><form id="numberform" class="stage" hidden><p id="term"></p><label for="number">Ergebnis dieses Rechenteils:</label><input id="number" autocomplete="off" style="width:150px" placeholder="z. B. −24"><button class="primary">Ergebnis prüfen</button></form><form id="rowform" class="stage" hidden><p id="results"></p><label for="row">Vollständige nächste Rechenzeile anschreiben:</label><input id="row" class="wide" autocomplete="off" spellcheck="false" placeholder="Ergebnisse einsetzen, Rest unverändert übertragen"><button class="primary">Zeile prüfen</button><p class="small">Nur die ausgewählten Teile ersetzen. Eckige Klammern um nur eine Zahl dürfen wegfallen. Multiplikation: . , · , × oder *.</p></form><div id="msg" role="status" aria-live="polite"></div><div class="tools"><button id="hint">Tipp</button><button id="reset">Aufgabe neu starten</button><button id="next" class="primary" hidden>Nächste offene Aufgabe</button></div></section><p class="small">Die Zusammenfassung erscheint automatisch, sobald alle vier Aufgaben richtig abgeschlossen sind. Offline nutzbar. Neuladen setzt alle Daten zurück.</p></div><section id="report" hidden tabindex="-1"><h1>Alle vier Aufgaben geschafft!</h1><h2>Standard-Gruppe – Zusammenfassung für die Lehrkraft</h2><div id="reporttext"></div><div class="tablewrap"><table><thead><tr><th>Aufgabe</th><th>Status</th><th>Endergebnis</th><th>Auswahlfehler</th><th>Vorzeichenfehler</th><th>Rechenfehler</th><th>Übertragungsfehler</th><th>Tipps</th></tr></thead><tbody id="reportbody"></tbody></table></div><p class="small">Fehlversuche sind keine Note. Jeder falsche Versuch zählt einzeln. Fehler und Tipps bleiben bei Aufgaben-Neustart erhalten. Die Sitzungsdauer enthält mögliche Pausen. Keine automatische Übermittlung; bitte zeigen, drucken oder als PDF weitergeben.</p><div class="tools noprint"><button id="print">Drucken / als PDF speichern</button><button id="review">Rechenwege ansehen</button></div></section><button id="returnreport" class="noprint" hidden>Zur Abschlusszusammenfassung</button><p class="small noprint">Erlaubt: . , · , × oder * für Multiplikation; : , ÷ oder / für Division. Leerzeichen und Minusvarianten werden vereinheitlicht. Ein Punkt bedeutet hier Multiplikation, keine Dezimalstelle.</p></main><script>
'use strict';const E=["(+11) · (−4) + (+7)", "(+13) − (+35) : (−5)", "(+17) + (−6) · (+4) − (+42) : (−7)", "[(+9) − (−5)] · (−4) + (+11)"],$=id=>document.getElementById(id),esc=s=>String(s).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;');
function clean(s){return String(s).normalize('NFKC').replace(/[\u200B-\u200D\u2060\uFEFF]/g,'').replace(/[\s\u00A0\u202F]/g,'').replace(/[\u2010-\u2015\u2212\uFE63\uFF0D]/g,'-').replace(/[×·⋅∙.]/g,'*').replace(/[÷:∶]/g,'/')}
function canonical(s){let x=clean(s);x=x.replace(/\(([+-]?\d+)\)/g,(_,n)=>'#'+Number(n)+'#');x=x.replace(/(^|\[)([+-]?\d+)(?=$|[\]+*/-])/g,(_,p,n)=>p+'#'+Number(n)+'#');x=x.replace(/([+*/-])([+-]?\d+)(?=$|[\]+*/-])/g,(_,p,n)=>p+'#'+Number(n)+'#');let prev;do{prev=x;x=x.replace(/\[(#-?\d+#)\]/g,'$1')}while(x!==prev);return x}
const signed=n=>'('+(n>=0?'+':'−')+Math.abs(n)+')',isnum=t=>typeof t==='object'&&t!==null&&'n' in t,num=n=>({n});
function initial(s){return (clean(s).match(/\([+-]?\d+\)|\[|\]|[+*/-]/g)||[]).map(t=>/^\(/.test(t)?num(Number(t.slice(1,-1))):t)}
function fmt(t){return t.map(x=>isnum(x)?signed(x.n):x==='*'?'·':x==='/'?':':x==='-'?'−':x).join(' ').replace(/\[\s+/g,'[').replace(/\s+\]/g,']')}
function compact(t){t=[...t];let changed=true;while(changed){changed=false;for(let j=0;j<t.length-2;j++)if(t[j]==='['&&isnum(t[j+1])&&t[j+2]===']'){t.splice(j,3,t[j+1]);changed=true;break}}return t}
function count(t){return t.filter(x=>typeof x==='string'&&['+','-','*','/'].includes(x)).length}
function operations(t){let depth=0,all=[];t.forEach((x,j)=>{if(x==='[')depth++;else if(x===']')depth--;else if(typeof x==='string'&&['+','-','*','/'].includes(x))all.push({j,depth,rank:['*','/'].includes(x)?1:0})});if(!all.length)return[];let d=Math.max(...all.map(x=>x.depth)),r=Math.max(...all.filter(x=>x.depth===d).map(x=>x.rank));return all.filter(x=>x.depth===d&&x.rank===r&&isnum(t[x.j-1])&&isnum(t[x.j+1])&&!all.some(p=>p.j===x.j-2&&p.depth===x.depth&&p.rank===x.rank)).map(o=>{let a=t[o.j-1].n,b=t[o.j+1].n,op=t[o.j],z=op==='+'?b:-b;return {...o,start:o.j-1,end:o.j+1,result:op==='+'?a+b:op==='-'?a-b:op==='*'?a*b:a/b,simple:['+','-'].includes(op)?a+(z>=0?' + ':' − ')+Math.abs(z):null}})}
function fresh(i){return {t:initial(E[i]),phase:'select',selected:[],queue:[],q:0,h:[],errors:[0,0,0,0],hints:0,start:null,last:''}}
let S=E.map((_,i)=>fresh(i)),i=0,finishedAt=null;
const allDone=()=>S.every(s=>s.phase==='done'),beginTime=s=>{if(!s.start)s.start=Date.now()};function msg(text,ok=false){$('msg').className=ok?'good':'bad';$('msg').textContent=text}function begin(s){s.queue=[...s.selected].sort((a,b)=>a.start-b.start);s.q=0;s.phase=s.queue[0].simple!==null?'sign':'number'}
function replaced(s){let t=[...s.t];[...s.queue].sort((a,b)=>b.start-a.start).forEach(o=>t.splice(o.start,3,num(o.result)));return t}
function marked(s){let out='',j=0;while(j<s.t.length){let o=s.queue.find(o=>o.start===j);if(o){out+='<u>'+esc(fmt(s.t.slice(o.start,o.end+1)))+'</u> ';j=o.end+1}else{out+=esc(fmt([s.t[j]]))+' ';j++}}return out}
function render(){let s=S[i];if(s.phase==='select'&&count(s.t)===1){s.selected=[operations(s.t)[0]];begin(s)}$('overall').textContent=S.filter(s=>s.phase==='done').length+' von '+E.length+' Aufgaben vollständig gelöst.';$('nav').innerHTML='';E.forEach((_,j)=>{let b=document.createElement('button');b.textContent=(j+1)+(S[j].phase==='done'?' ✓':'');b.className=j===i?'active':'';b.onclick=()=>{i=j;render()};$('nav').append(b)});$('title').textContent='Aufgabe '+(i+1)+' – '+count(initial(E[i]))+' Rechenoperationen';$('history').innerHTML=s.h.join('');$('msg').textContent='';['choose','signform','numberform','rowform','next'].forEach(id=>$(id).hidden=true);['sign','number','row'].forEach(id=>$(id).value='');$('hint').hidden=s.phase==='done';$('returnreport').hidden=!allDone();if(s.phase==='done'){$('equation').textContent='Endergebnis: '+s.last;$('instruction').textContent='Bis zum Schluss gelöst.';$('next').hidden=allDone();msg('Richtig!',true);return}
let single=count(s.t)===1,candidates=operations(s.t),groups=s.phase==='select'?s.selected:s.queue;$('instruction').textContent=single?'Eine Operation übrig: ohne Unterstreichen fertigrechnen.':s.phase==='select'?'Einen oder mehrere gleichrangige, unabhängige Rechenteile auswählen.':'Die ausgewählten Teile sind grün unterstrichen.';$('equation').innerHTML='';for(let j=0;j<s.t.length;){let g=groups.find(o=>o.start===j),b=document.createElement('button');b.type='button';b.className='part';if(g){b.textContent=fmt(s.t.slice(g.start,g.end+1))+' ';if(!single)b.classList.add('selected');b.onclick=()=>{if(s.phase==='select'){s.selected=s.selected.filter(o=>o.j!==g.j);render()}};j=g.end+1}else{let pos=j;b.textContent=fmt([s.t[j]])+' ';b.onclick=()=>{if(s.phase!=='select')return;beginTime(s);let o=candidates.find(o=>pos>=o.start&&pos<=o.end&&!s.selected.some(g=>!(o.end<g.start||o.start>g.end)));if(!o){s.errors[0]++;msg('Nicht jetzt auswählbar. Prüfe Rang, Klammern und links nach rechts.');return}s.selected.push(o);render()};j++}$('equation').append(b)}if(s.phase==='select')$('choose').hidden=false;if(s.phase==='sign')$('signform').hidden=false;if(s.phase==='number'){$('numberform').hidden=false;let o=s.queue[s.q];$('term').textContent='Aktueller Teil: '+fmt(s.t.slice(o.start,o.end+1))+(o.simple!==null?' → '+o.simple:'')}if(s.phase==='row'){$('rowform').hidden=false;$('results').textContent='Ergebnisse: '+s.queue.map(o=>fmt(s.t.slice(o.start,o.end+1))+' = '+o.result).join(' ; ')}}
$('choose').onclick=()=>{let s=S[i];beginTime(s);if(!s.selected.length){msg('Wähle mindestens einen Rechenteil aus.');return}begin(s);render()};
$('signform').onsubmit=e=>{e.preventDefault();let s=S[i];if(s.phase!=='sign')return;beginTime(s);let o=s.queue[s.q],n=x=>clean(x).replace(/^\+/,'');if(n($('sign').value)!==n(o.simple)){s.errors[1]++;msg('Vorzeichen noch nicht richtig. Löse nur die Vorzeichen auf, ohne auszurechnen.');return}s.phase='number';render();msg('Vorzeichen richtig. Jetzt berechnen!',true);$('number').focus()};
function save(s){s.h.push('<div class="eq past">'+marked(s)+'</div><p class="small good">'+s.queue.map(o=>(o.simple!==null?esc(o.simple)+' = ':'')+o.result).join(' ; ')+'</p>')}
$('numberform').onsubmit=e=>{e.preventDefault();let s=S[i];if(s.phase!=='number')return;beginTime(s);let o=s.queue[s.q],v=clean($('number').value);if(/^\([+-]?\d+\)$/.test(v))v=v.slice(1,-1);if(!/^[+-]?\d+$/.test(v)||Number(v)!==o.result){s.errors[2]++;msg('Ergebnis noch nicht richtig. Prüfe Berechnung und Vorzeichen.');return}s.q++;if(s.q<s.queue.length){s.phase=s.queue[s.q].simple!==null?'sign':'number';render();return}let t=compact(replaced(s));if(count(t)===0){save(s);s.t=t;s.last=t[0].n;s.phase='done';render();if(allDone()){finishedAt=Date.now();showReport()}}else{s.phase='row';render();$('row').focus()}};
$('rowform').onsubmit=e=>{e.preventDefault();let s=S[i];if(s.phase!=='row')return;if(canonical($('row').value)!==canonical(fmt(replaced(s)))){s.errors[3]++;msg('Übertragung noch nicht richtig. Setze alle ausgewählten Ergebnisse ein und übertrage den Rest unverändert. Punkt und Minusvarianten sind erlaubt.');return}save(s);s.t=compact(replaced(s));s.phase='select';s.selected=[];s.queue=[];s.q=0;render();msg(count(s.t)===1?'Richtig übertragen! Jetzt ohne Unterstreichen fertigrechnen.':'Richtig übertragen! Wähle die nächsten Rechenteile.',true)};
$('hint').onclick=()=>{let s=S[i];beginTime(s);s.hints++;if(s.phase==='select')msg('Mögliche Teile: '+operations(s.t).map(o=>fmt(s.t.slice(o.start,o.end+1))).join(' ; '),true);else if(s.phase==='sign')msg('Vorzeichen aufgelöst: '+s.queue[s.q].simple,true);else if(s.phase==='number')msg('Rechne den angezeigten Teil aus. Gleiche Vorzeichen bei Multiplikation/Division ergeben Plus, verschiedene Minus.',true);else msg('Nächste Zeile: '+fmt(compact(replaced(s))),true)};
$('reset').onclick=()=>{let old=S[i],s=fresh(i);s.errors=old.errors;s.hints=old.hints;s.start=old.start;S[i]=s;finishedAt=null;$('report').hidden=true;render()};$('next').onclick=()=>{for(let n=1;n<=S.length;n++){let j=(i+n)%S.length;if(S[j].phase!=='done'){i=j;render();return}}};
function showReport(){if(!allDone())return;let end=finishedAt||Date.now(),name=$('name').value.trim()||'Kein Name eingetragen',starts=S.filter(s=>s.start).map(s=>s.start),mins=starts.length?Math.round((end-Math.min(...starts))/60000):0;$('reporttext').innerHTML='<p>Name: '+esc(name)+'<br>Abschluss: '+esc(new Date(end).toLocaleString('de-AT'))+'<br>Vollständig gelöst: '+E.length+' von '+E.length+'<br>Fehlversuche: '+S.reduce((a,s)=>a+s.errors.reduce((x,y)=>x+y,0),0)+' · Tipps: '+S.reduce((a,s)=>a+s.hints,0)+'<br>Sitzungsdauer seit erster Bearbeitung: ca. '+mins+' Minuten</p>';$('reportbody').innerHTML=S.map((s,j)=>'<tr><td>'+(j+1)+'</td><td>Abgeschlossen</td><td>'+esc(s.last)+'</td>'+s.errors.map(n=>'<td>'+n+'</td>').join('')+'<td>'+s.hints+'</td></tr>').join('');$('learning').hidden=true;$('returnreport').hidden=true;$('report').hidden=false;$('report').focus();$('report').scrollIntoView({behavior:'smooth'})}
$('print').onclick=()=>window.print();$('review').onclick=()=>{$('report').hidden=true;$('learning').hidden=false;render();$('learning').scrollIntoView({behavior:'smooth'})};$('returnreport').onclick=showReport;render();
</script></body></html>
